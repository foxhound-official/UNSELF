      m_Calls: []
  m_text: "\u0420\u0430\u0437\u0433\u043E\u043D\u0438\u0442\u0435\u0441\u044C \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E W + Shift, \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 Ctrl, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043F\u043E\u0434\u043A\u0430\u0442.\n\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0434\u043A\u0430\u0442\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0438\u043D\u0435\u0440\u0446\u0438\u044E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0438 \u043C\u043E\u0436\u0435\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435.\n\n\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C Ctrl: \u043F\u0440\u0435\u0440\u0432\u0430\u0442\u044C \u043F\u043E\u0434\u043A\u0430\u0442.\nSpace: \u0432\u044B\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C \u0438\u0437 \u043F\u043E\u0434\u043A\u0430\u0442\u0430, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C.\n\n\u041F\u043E\u0434\u043A\u0430\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0438\u043B\u0438 \u0438\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u041C\u0435\u0436\u0434\u0443 \u043F\u043E\u0434\u043A\u0430\u0442\u0430\u043C\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430."
