  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0440\u044B\u0433\u043D\u0438\u0442\u0435 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E \u0443\u0441\u0442\u0443\u043F\u0430 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C Space. \u0422\u0430\u043A\u0436\u0435 Space \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u0436\u0438\u043C\u0430\u0442\u044C \u0443\u0436\u0435 \u0432 \u043F\u043E\u043B\u0435\u0442\u0435 \u0438\u043B\u0438 \u043F\u0430\u0434\u0435\u043D\u0438\u0438.\n\n\u0415\u0441\u043B\u0438 \u043A\u0440\u0430\u0439 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B \u0438\u043B\u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u0434\u043E\u0441\u044F\u0433\u0430\u0435\u043C\u043E\u0441\u0442\u0438 \u0438 \u0443\u0434\u043E\u0432\u043B\u0435\u0432\u0442\u0432\u043E\u0440\u044F\u0435\u0442 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C, \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0437\u0430\u0446\u0435\u043F\u0438\u0442\u0441\u044F \u0437\u0430 \u043D\u0435\u0433\u043E \u0438 \u043F\u043E\u0434\u0442\u044F\u043D\u0435\u0442\u0441\u044F \u043D\u0430\u0432\u0435\u0440\u0445.\n\n(\u0412 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u043C\u0435\u0440 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0441\u0432\u0435\u0440\u0445\u0443, \u0435\u0435 \u0443\u0433\u043E\u043B \u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0438, \u043C\u043E\u0436\u0435\u0442 \u043B\u0438 \u0442\u0443\u0434\u0430 \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u0441\u044F \u0438\u0433\u0440\u043E\u043A \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442\u0441\u044F \u043F\u0443\u0442\u044C \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438, \u0432\u0441\u0451 \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u043C\u043E\u0436\u0435\u0442 \u043B\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u0441\u0442\u043E\u044F\u0442\u044C \u0441\u0432\u0435\u0440\u0445\u0443)"
