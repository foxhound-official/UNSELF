  - {fileID: 11400000, guid: 737833db12c05eb44be87685d66e619b, type: 2}
  shortDescription: "\u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0435 \u043D\u0430\u0432\u044B\u043A\u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0432 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0440\u0435\u0434\u0435."
  personalityDescription: "\u041D\u043E\u0441\u0438\u0442\u0435\u043B\u044C \u043F\u0440\u0438\u0432\u044B\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F. \u041F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u0432, \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0439 \u0438 \u0442\u043E\u0447\u0435\u043A \u043E\u043F\u043E\u0440\u044B."
  memoryRecord: "\xAB\u0411\u0435\u0442\u043E\u043D \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438 \u0434\u0440\u043E\u0436\u0438\u0442. \u0417\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u043A\u0442\u043E-\u0442\u043E \u043A\u0440\u0438\u0447\u0438\u0442. \u0414\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u0439 \u043A\u0440\u044B\u0448\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E, \u043D\u043E \u0442\u0435\u043B\u043E \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F \u043A \u043F\u0440\u044B\u0436\u043A\u0443...\xBB"
  gameplayEffects: "\u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u043D\u0430\u044F \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C: \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u044B\u0439 \u0441\u043F\u0440\u0438\u043D\u0442, \u043F\u0440\u044B\u0436\u043E\u043A \u0438 \u043F\u043E\u0434\u043A\u0430\u0442."
